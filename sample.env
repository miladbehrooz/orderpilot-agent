# Copy to .env and fill in the values:  cp sample.env .env
# Never commit .env.

# --- Database ---------------------------------------------------------------
# SQLite file built by scripts/build_db.py
ORDERPILOT_DB_PATH=ecommerce.sqlite

# --- Logging -----------------------------------------------------------------
# TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# --- LLM provider (open decision: fill in the one you use) -----------------
# LLM_PROVIDER: openai or anthropic. LLM_MODEL: the provider's model name.
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Tracing / evals (optional, LangSmith) ---------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderpilot
